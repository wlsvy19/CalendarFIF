rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.uid == '__OWNER_UID__'; }
    function isActive(uid) {
      return exists(/databases/$(database)/documents/access/$(uid))
        && get(/databases/$(database)/documents/access/$(uid)).data.disabled == false;
    }
    function validAccess(d) {
      return d.keys().hasOnly(['email', 'role', 'disabled', 'createdAt'])
        && d.keys().hasAll(['email', 'role', 'disabled', 'createdAt'])
        && d.email is string && d.email.size() > 0 && d.email.size() <= 320
        && (d.role == 'admin' || d.role == 'user')
        && d.disabled is bool
        && d.createdAt is number;
    }

    // 달력: 자기 것만. 관리자는 access 문서를 읽지 않고 통과한다(읽기 비용이 늘지 않고 가져오기가 그대로 동작한다).
    match /users/{uid}/months/{monthId} {
      allow read, write: if signedIn()
        && request.auth.uid == uid
        && monthId.matches('^[0-9]{4}-[0-9]{2}$')
        && (uid == '__OWNER_UID__' || isActive(uid));
    }

    // 알림과 카운트다운: 문서 하나(events). 달 문서와 같은 사람만.
    match /users/{uid}/data/{docId} {
      allow read, write: if signedIn()
        && request.auth.uid == uid
        && docId == 'events'
        && (uid == '__OWNER_UID__' || isActive(uid));
    }

    // 사용 허가: 관리자만 쓰고 목록을 본다. 사용자는 자기 것을 읽기만 한다.
    match /access/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && validAccess(request.resource.data)
        && (request.resource.data.role == 'admin') == (uid == '__OWNER_UID__')
        && (uid != '__OWNER_UID__' || request.resource.data.disabled == false);
      allow delete: if isAdmin() && uid != '__OWNER_UID__';
    }
  }
}
