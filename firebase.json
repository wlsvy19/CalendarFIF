{
  "firestore": {
    "database": "(default)",
    "location": "asia-northeast3",
    "rules": "build/firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "headers": [
      { "source": "**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
  },
  "emulators": {
    "firestore": { "port": 8085 },
    "auth": { "port": 9095 },
    "ui": { "enabled": false }
  }
}
